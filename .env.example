# ==============================================================================
# CloudNotes Environment Configuration Example
# ==============================================================================
# NOTE: Zero personal secrets policy strictly enforced. 
# RFC 2606 dummy domains and dummy keys are used for template demonstration.

# PocketBase Server URL (Default local development)
VITE_POCKETBASE_URL=http://127.0.0.1:8090
EXPO_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Production Cloudflare Tunnel / Custom Domain example
# VITE_POCKETBASE_URL=https://notes.example.com
# EXPO_PUBLIC_POCKETBASE_URL=https://notes.example.com

# Cloudflare Tunnel Token (For docker-compose deployment)
# Replace with your actual tunnel token in your private .env
TUNNEL_TOKEN=eyJhEXAMPLE_TUNNEL_TOKEN_DO_NOT_COMMIT

# AI Assistant Providers (BYOK - Bring Your Own Key)
# Users configure these via application settings, but default environment fallbacks can be supplied:
# VITE_DEFAULT_GEMINI_KEY=AIzaSyExampleKey123456789
# VITE_DEFAULT_OPENAI_KEY=sk-proj-exampleKey123456789
# VITE_DEFAULT_GROQ_KEY=gsk_exampleKey123456789
# VITE_DEFAULT_DEEPSEEK_KEY=sk-exampleDeepSeekKey123456789
